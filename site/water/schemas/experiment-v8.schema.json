{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geogeeklab.github.io/water/schemas/experiment-v8.schema.json",
  "title": "Water as Spectrum V10.1 semi-analytical + sampled numerical RT experiment (schema 8)",
  "description": "Version-8 reproducible experiment with independently computed but not externally validated azimuth-averaged scalar DOM reference-grid selection.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "appVersion",
    "model",
    "science",
    "state",
    "scenarioA",
    "sensor",
    "spectra",
    "waterRT"
  ],
  "properties": {
    "kind": {
      "const": "water-as-spectrum"
    },
    "schemaVersion": {
      "const": 8
    },
    "appVersion": {
      "const": "10.1.0"
    },
    "model": {
      "type": "object",
      "required": [
        "id",
        "modelVersion"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "modelVersion": {
          "type": "string"
        }
      }
    },
    "science": {
      "type": "object",
      "required": [
        "modelType",
        "modelId",
        "scienceModelVersion",
        "modelVariant",
        "domainNm",
        "researchValidated",
        "limitations"
      ],
      "properties": {
        "modelType": {
          "const": "SEMI_ANALYTICAL"
        },
        "modelId": {
          "type": "string"
        },
        "scienceModelVersion": {
          "type": "string"
        },
        "modelVariant": {
          "enum": [
            "V9_COMPAT_FIXED_SLOPES",
            "V10_EXPLORATORY_CUSTOM_SLOPES"
          ]
        },
        "domainNm": {
          "type": "array",
          "prefixItems": [
            {
              "const": 400
            },
            {
              "const": 700
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "researchValidated": {
          "const": false
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "state": {
      "type": "object",
      "required": [
        "params",
        "sensor",
        "probeNm",
        "rtCase",
        "rtSun",
        "rtWl",
        "rtDepth"
      ],
      "properties": {
        "sensor": {
          "enum": [
            "olci",
            "oci",
            "msi",
            "oli"
          ]
        },
        "probeNm": {
          "type": "integer",
          "minimum": 400,
          "maximum": 700
        },
        "params": {
          "type": "object",
          "required": [
            "chl",
            "ag",
            "anap",
            "bbp",
            "eta",
            "sg",
            "snap"
          ],
          "properties": {
            "chl": {
              "type": "number",
              "minimum": 0.02,
              "maximum": 25
            },
            "ag": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "anap": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "bbp": {
              "type": "number",
              "minimum": 0.0001,
              "maximum": 0.03
            },
            "eta": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "sg": {
              "type": "number",
              "minimum": 0.005,
              "maximum": 0.03
            },
            "snap": {
              "type": "number",
              "minimum": 0.005,
              "maximum": 0.03
            }
          }
        },
        "rtCase": {
          "enum": [
            "clear",
            "phyto",
            "cdom"
          ]
        },
        "rtSun": {
          "enum": [
            0,
            30,
            60
          ]
        },
        "rtWl": {
          "enum": [
            440,
            490,
            550,
            620,
            680
          ]
        },
        "rtDepth": {
          "enum": [
            0,
            0.5,
            1,
            2,
            3,
            5,
            7,
            10,
            15,
            20
          ]
        }
      }
    },
    "scenarioA": {
      "type": "object"
    },
    "scenarioB": {
      "type": [
        "object",
        "null"
      ]
    },
    "sensor": {
      "type": "object",
      "required": [
        "rrs",
        "toa",
        "bandValidity"
      ]
    },
    "spectra": {
      "type": "object"
    },
    "waterRT": {
      "type": "object",
      "required": [
        "datasetSchema",
        "caseId",
        "szaInWaterDeg",
        "wavelengthNm",
        "depthM",
        "status"
      ],
      "properties": {
        "datasetSchema": {
          "const": "water-rt-reference-v1"
        },
        "caseId": {
          "enum": [
            "clear",
            "phyto",
            "cdom"
          ]
        },
        "szaInWaterDeg": {
          "enum": [
            0,
            30,
            60
          ]
        },
        "wavelengthNm": {
          "enum": [
            440,
            490,
            550,
            620,
            680
          ]
        },
        "depthM": {
          "enum": [
            0,
            0.5,
            1,
            2,
            3,
            5,
            7,
            10,
            15,
            20
          ]
        },
        "status": {
          "enum": [
            "ready",
            "loading",
            "error",
            "missing"
          ]
        },
        "referenceEngine": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "type": "string"
        },
        "ioPs": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    }
  },
  "additionalProperties": true
}
