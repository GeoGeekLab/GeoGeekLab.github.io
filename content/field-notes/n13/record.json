    "en": {
      "type": "Archive Essay",
      "title": "Some Trends Are Artifacts of Ignored Autocorrelation",
      "tags": [
        "Time Series",
        "Autocorrelation",
        "Trend"
      ],
      "read": "3 min",
      "excerpt": "Long time series contain memory. If that dependence is ignored, apparent accelerations, breakpoints, and regime shifts can look more certain than the evidence allows.",
      "series": "Attribution & Causality",
      "status": "Archived",
      "source": "GeoGeek · WeChat",
      "published": "2026.04.19",
