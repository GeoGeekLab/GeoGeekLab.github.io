    "en": {
      "type": "Archive Essay",
      "title": "When Nature Disagrees with Nature: The Observation Problem in Remote Sensing",
      "tags": [
        "Amazon",
        "Observation Geometry",
        "Sampling"
      ],
      "read": "6 min",
      "excerpt": "Two apparently conflicting studies of Amazon seasonality expose two different failures of remote sensing: seeing a signal created by geometry, and failing to sample enough of the phenomenon.",
